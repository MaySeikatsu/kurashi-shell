// Written by kurashid from the theme (K49). Do not edit: it is rewritten.
// Use it in ~/.config/zellij/config.kdl:   theme "kurashi"
themes {
    kurashi {
        fg "{{colors.on_surface.default.hex}}"
        bg "{{colors.surface_container_high.default.hex}}"
        black "{{colors.surface.default.hex}}"
        red "{{colors.error.default.hex}}"
        green "{{colors.primary.default.hex}}"
        yellow "{{colors.warning.default.hex}}"
        blue "{{colors.secondary.default.hex}}"
        magenta "{{colors.tertiary.default.hex}}"
        cyan "{{colors.secondary.default.hex}}"
        white "{{colors.on_surface.default.hex}}"
        orange "{{colors.warning.default.hex}}"
    }
}
