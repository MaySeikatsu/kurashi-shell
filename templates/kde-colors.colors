# kurashi: KDE colour scheme (written by kurashid, K49). Pick "Kurashi" in a KDE app's Settings › Window Color
# Scheme (Dolphin, Kate, Okular …), or make it everyone's in kdeglobals ([UiSettings] ColorScheme=Kurashi).
[ColorEffects:Disabled]
Color={{colors.surface_container.default.hex}}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{colors.surface.default.hex}}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{colors.surface_container.default.hex}}
BackgroundNormal={{colors.surface_container_high.default.hex}}
DecorationFocus={{colors.primary.default.hex}}
DecorationHover={{colors.primary.default.hex}}
ForegroundActive={{colors.on_surface.default.hex}}
ForegroundInactive={{colors.on_surface_variant.default.hex}}
ForegroundLink={{colors.secondary.default.hex}}
ForegroundNegative={{colors.error.default.hex}}
ForegroundNeutral={{colors.warning.default.hex}}
ForegroundNormal={{colors.on_surface.default.hex}}
ForegroundPositive={{colors.success.default.hex}}
ForegroundVisited={{colors.tertiary.default.hex}}

