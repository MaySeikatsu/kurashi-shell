[General]
ColorScheme=Kurashi
Name=Kurashi
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{colors.surface_container.default.hex}}
activeBlend={{colors.surface_container.default.hex}}
activeForeground={{colors.on_surface.default.hex}}
