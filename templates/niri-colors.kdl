// Written by kurashid from the theme (K49, W34; colours from DankMaterialShell, MIT). Do not edit: it is rewritten.
// Include it in ~/.config/niri/config.kdl after your own layout, window-rule and animations blocks, so that its values
// take effect:
//   include "kurashi.kdl"

layout {

    // "Window frames" on: the border (active and inactive colours) in place of the focus ring. The active colour is
    // `theme.window_frame_color`.
    focus-ring {
        {{frame.niri.ring}}
        width {{shape.border}}
        active-color   "{{frame.active.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    border {
        {{frame.niri.border}}
        width {{shape.border}}
        active-color   "{{frame.active.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    shadow {
        color "{{colors.shadow.default.hex}}70"
    }

    tab-indicator {
        active-color   "{{frame.active.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

// Window corners follow the shell's panels (radius.lg; square under shape none). clip-to-geometry clips the window's
// content to those corners too.
window-rule {
    geometry-corner-radius {{shape.radius}}
    clip-to-geometry true
}

// "See-through unfocused windows": every window but the focused one.
{{opacity.niri}}

// The shell's motion profile: calm and lively are springs, none switches niri's animations off.
{{motion.niri}}
