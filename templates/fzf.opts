--color=bg:-1,fg:{{colors.on_surface.default.hex}},hl:{{colors.primary.default.hex}}
--color=bg+:{{colors.surface_container_high.default.hex}},fg+:{{colors.on_surface.default.hex}},hl+:{{colors.primary.default.hex}}
--color=border:{{colors.outline_variant.default.hex}},separator:{{colors.outline_variant.default.hex}},scrollbar:{{colors.outline.default.hex}}
--color=prompt:{{colors.primary.default.hex}},pointer:{{colors.primary.default.hex}},marker:{{colors.tertiary.default.hex}}
--color=info:{{colors.on_surface_variant.default.hex}},spinner:{{colors.tertiary.default.hex}},header:{{colors.secondary.default.hex}}
--color=gutter:-1,query:{{colors.on_surface.default.hex}},label:{{colors.on_surface_variant.default.hex}}
