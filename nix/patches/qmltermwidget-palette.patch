+void TerminalDisplay::setColors(const QVariantList &colors)
+{
+    if (colors.size() < 18)
+        return;
+    ColorEntry table[TABLE_COLORS];
+    for (int i = 0; i < TABLE_COLORS; i++)
+        table[i] = _colorTable[i];
+    const QColor fg = colors.at(0).value<QColor>();
+    const QColor bg = colors.at(1).value<QColor>();
+    table[DEFAULT_FORE_COLOR] = ColorEntry(fg, false);
+    table[DEFAULT_BACK_COLOR] = ColorEntry(bg, true);
+    table[DEFAULT_FORE_COLOR + BASE_COLORS] = ColorEntry(fg, false);
+    table[DEFAULT_BACK_COLOR + BASE_COLORS] = ColorEntry(bg, true);
+    for (int i = 0; i < 8; i++) {
+        table[2 + i] = ColorEntry(colors.at(2 + i).value<QColor>(), false);
+        table[2 + i + BASE_COLORS] = ColorEntry(colors.at(10 + i).value<QColor>(), false);
+    }
+    setColorTable(table);
+    QColor fill(bg);
+    fill.setAlphaF(_opacity);
+    setFillColor(fill);
+    update();
+}
+
+void TerminalDisplay::setBackgroundOpacity(qreal opacity)
+{
+    setOpacity(opacity);
+    QColor fill(_colorTable[DEFAULT_BACK_COLOR].color);
+    fill.setAlphaF(_opacity);
+    setFillColor(fill);
+    update();
+}
